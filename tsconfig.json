{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "importHelpers": true,
    "target": "es2021",
    "module": "es2020",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": false,
    "typeRoots": ["node_modules/@types"]
  }
}
